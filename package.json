{
  "name": "petdate",
  "version": "1.0.0",
  "private": true,
  "description": "petdate — پیدا کردن همبازی برای پت",
  "scripts": {
    "dev": "npm run dev -w @petdate/web",
    "dev:api": "npm run dev -w @petdate/api",
    "dev:bot": "npm run dev -w @petdate/bot",
    "build": "npm run build -w @petdate/shared && npm run build -w @petdate/web",
    "build:all": "npm run build -w @petdate/shared && npm run build -w @petdate/api && npm run build -w @petdate/bot && npm run build -w @petdate/web",
    "typecheck": "npm run build:all",
    "test:self": "bash ./scripts/ci-selftest.sh",
    "check:main-mini-app": "bash ./scripts/check-main-mini-app.sh",
    "predeploy-check": "bash ./scripts/predeploy-check.sh",
    "preview": "npm run preview -w @petdate/web",
    "infra:up": "docker compose up -d",
    "infra:up:search": "docker compose --profile search up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:elasticsearch": "bash ./scripts/ensure-elasticsearch.sh"
  },
  "workspaces": [
    "packages/*"
  ]
}
