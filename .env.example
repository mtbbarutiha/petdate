# petdate — Environment

# ── App ──
NODE_ENV=development
WEB_URL=http://localhost:5173
# Public HTTPS URL for Telegram inline link buttons (tunnel/prod). Leave empty in local dev.
PUBLIC_WEB_URL=
# Prescription PDF download origin for SMS (production: https://pdf.petdate.ir)
PUBLIC_PDF_URL=
API_URL=http://localhost:3001
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# ── API ──
PORT=3001

# PostgreSQL + PostGIS (آینده — هنوز adapter ندارد؛ API فعلی از SQLite می‌خواند)
# اگر ست شود فقط در مانیتورینگ «configured» دیده می‌شود، نه به‌عنوان دیتابیس فعال.
DATABASE_URL=

# SQLite — تنها منبع حقیقت برای کاربران/پت‌ها (وب + ربات از همین فایل از طریق API)
# در پروداکشن مسیر مطلق بگذارید (ecosystem.config.cjs هم همین را ست می‌کند):
# DATABASE_PATH=/opt/petdate/packages/api/data/petdate.db
DATABASE_PATH=./packages/api/data/petdate.db

# Redis — session bot، presence، match queue
REDIS_URL=redis://localhost:6379

# MinIO / S3 — عکس‌ها و backup
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=petdate
S3_SECRET_KEY=petdate_secret
S3_BUCKET=petdate-media
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/petdate-media

# Elasticsearch — search + admin monitoring (compose profile: search, or native systemd)
# Production VPS: scripts/ensure-elasticsearch.sh sets this when ES is running.
ELASTICSEARCH_URL=http://localhost:9200

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
# Optional Bot API root (no trailing slash). Default: https://api.telegram.org
# Use a local Bot API server when egress to api.telegram.org is flaky.
# TELEGRAM_API_ROOT=https://api.telegram.org
# Short retries for bot/api/ops scripts (default 4 × ~250ms backoff; not multi-minute)
# TELEGRAM_HTTP_RETRIES=4
# TELEGRAM_HTTP_RETRY_MS=250

# عضویت اجباری در کانال (بدون @) — فعلاً فقط petdate
FORCE_JOIN_PETDATE_CHANNEL=petdating
# FORCE_JOIN_DORDORIA_CHANNEL=dordoriabot

# ادمین‌های ربات (شناسه عددی تلگرام، جدا با کاما) — صف احراز هویت مالکین
# مثال: TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=
# معادل TELEGRAM_ADMIN_IDS (هر دو خوانده می‌شوند)
ADMIN_TELEGRAM_IDS=
# رمز /admin وقتی لیست ادمین خالی است (پیش‌فرض petdate)
ADMIN_PASSWORD=petdate
# نقش پشتیبانی پنل وب (اختیاری) — ورود با همین رمز یا با ADMIN_SUPPORT_USER
# ADMIN_SUPPORT_PASSWORD=
# ADMIN_SUPPORT_USER=support

# ── Payments — خرید سکه ──
# شماره کارت واریز (کارت‌به‌کارت) — فقط در .env پروداکشن؛ اینجا نمونه
PAYMENT_CARD_NUMBER=6037XXXXXXXXXXXX
PAYMENT_CARD_HOLDER=
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=

# ── Candoo SMS (OTP احراز موبایل) ──
CANDOO_API_URL=https://api.candoosms.com
CANDOO_API_KEY=
# Only list sender numbers that Candoo accepts for this API key.
# A rejected src (e.g. statusCode -4) causes intermittent OTP failures under round-robin.
CANDOO_SRC_NUMBERS=989999176033

# ── SMTP (OTP ایمیل وب) ──
# Production (local Postfix on VPS):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_FROM=no-reply@petdate.ir
# SMTP_FROM_NAME=PetDate
# SMTP_HELO_NAME=mail.petdate.ir
# SMTP_REPLY_TO=info@petdate.ir
# SMTP_TLS_REJECT_UNAUTHORIZED=0
# (optional) SMTP_IGNORE_TLS=0  # force STARTTLS to local Postfix
#
# External SMTP alternative:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@petdate.ir
# SMTP_FROM_NAME=PetDate
# SMTP_SECURE=false
# Local Postfix (127.0.0.1): STARTTLS is skipped by default (ignoreTLS).
# Force STARTTLS locally: SMTP_IGNORE_TLS=0 and SMTP_TLS_REJECT_UNAUTHORIZED=0
# Remote self-signed: SMTP_TLS_REJECT_UNAUTHORIZED=0
# (also auto-relaxed for 127.0.0.1/localhost, or when SMTP_USER/PASS unset)

# جایزه تأیید احراز چهره (سکه)
FACE_VERIFY_REWARD=100
# SIGNUP_BONUS=20 and PROFILE_SECTION_REWARD=5 are code constants in @petdate/shared

# Web OTP: در development به‌صورت پیش‌فرض کد در پاسخ JSON برمی‌گردد.
# در production هرگز برنمی‌گردد. برای لوکال بدون echo: WEB_OTP_DEV_ECHO=0
# WEB_OTP_DEV_ECHO=1

# ── Production (petdate.ir + CDN) ──
# Point CDN origin to this VPS. Public URLs must be HTTPS for Telegram buttons + OTP host line.
# WEB_URL=https://petdate.ir
# PUBLIC_WEB_URL=https://petdate.ir
# PUBLIC_PDF_URL=https://pdf.petdate.ir
# PUBLIC_API_URL=https://petdate.ir
# API_URL=http://127.0.0.1:3001
# NODE_ENV=production

# ── AI consult (پاشا یزدانی + پشتیبانی) ──
# OpenAI-compatible Chat Completions + Whisper speech-to-text for voice notes.
# REQUIRED on VPS: without a key, Pasha only uses offline topic templates.
# With a key: any real trainer question is answered online (LLM); greetings stay local.
# Voice notes in AI trainer/vet/support chats are transcribed via Whisper (same key).
# Without a key, voice gets a polite Persian “please type” fallback (no crash).
# Set in /opt/petdate/.env then: pm2 restart petdate-api
# AI_CONSULT_API_KEY=
# AI_CONSULT_BASE_URL=https://api.openai.com/v1
# AI_CONSULT_MODEL=gpt-4o-mini
# AI_CONSULT_STT_MODEL=whisper-1
# (aliases also accepted: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL / OPENAI_STT_MODEL)

# ── Site analytics / Clarity / GTM (optional) ──
# First-party pageview beacon is always on (POST /api/analytics/collect).
# Microsoft Clarity: only load when Project ID is a valid Clarity id (NOT a UUID).
# The Cursor agent UUID 4b79bfb4-… is rejected by Clarity as "Invalid project id".
# Live petdate.ir project (also the in-code production default when env is unset):
VITE_CLARITY_PROJECT_ID=ygkl5nck6k
CLARITY_PROJECT_ID=ygkl5nck6k
# Google Tag Manager: official snippet lives in packages/web/index.html (GTM-KQPJT9Q4).
# VITE_GTM_ID / GTM_ID are for admin reports + SPA dataLayer pageview gating (not /admin).
VITE_GTM_ID=GTM-KQPJT9Q4
GTM_ID=GTM-KQPJT9Q4
# Optional GA4 Measurement ID — prefer wiring via GTM; dual gtag.js also loads when set.
# Do NOT invent a G- id. Can also be saved in admin platform settings (ga4MeasurementId).
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXX
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXX
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# GOOGLE_ANALYTICS_ID=G-XXXXXXXX
